rules_version = '2';

// OPTIMUS '27 — who may touch what.
//
//  - Participants sign in with Google. They can read only their own profile and the
//    registrations they are part of. They can never list or read anyone else's details.
//  - Nobody can write profiles, IDs or registrations from the website: that is done by the
//    Cloud Functions (functions/index.js), which run with admin rights and check everything.
//  - Admins (the two Google accounts below) can read everything and manage announcements and
//    event edits. The same two accounts are listed in functions/index.js and src/backend.ts.
//  - Announcements and event edits are public to read, because the site shows them to everyone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['srsanthosh7117@gmail.com', 'work.sanjai26@gmail.com'];
    }

    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    match /registrations/{regId} {
      allow get: if signedIn() && (isAdmin() || request.auth.uid in resource.data.memberUids);
      allow list: if isAdmin();
      allow write: if false;
    }

    match /announcements/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['message', 'active', 'created_at'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 300
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /eventOverrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // optimusIds, teamSlots, counters and anything else: functions only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
