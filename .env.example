# Copy this file to .env.local and fill in the values from the Supabase dashboard
# (Project settings > API). The anon key is public by design: what a visitor can read or
# change is decided by the row-level-security rules in supabase/schema.sql, not by hiding it.
# Never put the service_role key here. Without these values the site runs in browser-only demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
