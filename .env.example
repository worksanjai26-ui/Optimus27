# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings > General > Your apps > Web app > SDK setup and configuration).
# These are identifiers, not secrets. Without them the site runs in browser-only demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Where the Cloud Functions are deployed (must match setGlobalOptions in functions/index.js).
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Optional: reCAPTCHA v3 site key, to switch on Firebase App Check.
VITE_RECAPTCHA_SITE_KEY=
